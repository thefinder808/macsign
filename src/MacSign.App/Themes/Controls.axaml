<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ════════════════════════════════════════════════════════════════
         MacSign primitive styles. Class-based, token-driven (DynamicResource),
         mapped from the Native Pro prototype's primitives (np-theme.jsx).
         ════════════════════════════════════════════════════════════════ -->

    <!-- ── Text roles ── -->

    <!-- Section eyebrow: 11/700 uppercase tertiary. (Write the text uppercase
         in markup — Avalonia TextBlock has no text-transform.) -->
    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Ink3}" />
    </Style>

    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>

    <Style Selector="TextBlock.subtitle">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Ink2}" />
    </Style>

    <Style Selector="TextBlock.fieldlabel">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Ink2}" />
    </Style>

    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    </Style>

    <Style Selector="TextBlock.dim">
        <Setter Property="Foreground" Value="{DynamicResource Ink3}" />
    </Style>

    <!-- ── Buttons ── base resets the Fluent look; classes paint the variants. -->

    <Style Selector="Button">
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- primary -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentInk}" />
    </Style>
    <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Accent}" />
        <Setter Property="Opacity" Value="0.92" />
    </Style>
    <Style Selector="Button.primary:pressed">
        <Setter Property="RenderTransform" Value="translateY(0.5px)" />
    </Style>

    <!-- secondary -->
    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="{DynamicResource Field}" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Hair}" />
        <Setter Property="Height" Value="30" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.secondary /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Field}" />
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Hair}" />
    </Style>

    <!-- ghost -->
    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Ink2}" />
    </Style>
    <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Hair}" />
    </Style>

    <!-- ── Text fields ── -->

    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource Field}" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Hair}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource Hair2}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentLine}" />
    </Style>
    <Style Selector="TextBox.mono">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    </Style>
    <!-- borderless inline-editable text (profile name) -->
    <Style Selector="TextBox.bare">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="24" />
    </Style>

    <!-- ── Cards & surfaces ── -->

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Hair}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BoxShadow" Value="0 1 3 0 #0A000000" />
    </Style>

    <Style Selector="Border.cardSolid">
        <Setter Property="Background" Value="{DynamicResource PanelSolid}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Hair}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <!-- Dashed drop hint -->
    <Style Selector="Border.dropHint">
        <Setter Property="BorderBrush" Value="{DynamicResource Hair2}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <!-- ── Sidebar nav items ── Button.nav + class-bound .active. -->

    <Style Selector="Button.nav">
        <Setter Property="Height" Value="30" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.nav /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Hair}" />
    </Style>
    <Style Selector="Button.nav.active">
        <Setter Property="Foreground" Value="{DynamicResource AccentInk}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.nav.active /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Accent}" />
        <Setter Property="BoxShadow" Value="0 1 2 0 #26000000" />
    </Style>
    <!-- icon strokes (Path doesn't inherit Foreground) -->
    <Style Selector="Button.nav Path">
        <Setter Property="Stroke" Value="{DynamicResource Ink2}" />
    </Style>
    <Style Selector="Button.nav.active Path">
        <Setter Property="Stroke" Value="{DynamicResource AccentInk}" />
    </Style>
    <!-- right-aligned count badge -->
    <Style Selector="Button.nav Border.navbadge">
        <Setter Property="Background" Value="{DynamicResource Hair}" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="MinWidth" Value="18" />
    </Style>
    <Style Selector="Button.nav.active Border.navbadge">
        <Setter Property="Background" Value="#38FFFFFF" />
    </Style>
    <Style Selector="Button.nav Border.navbadge TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="Foreground" Value="{DynamicResource Ink2}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.nav.active Border.navbadge TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AccentInk}" />
    </Style>

    <!-- ── Segmented control (credential selector) ── Button.segment + .active.
         Custom template so each segment fills its grid third, centers its
         content, and the active one shows a filled rounded card. -->
    <Style Selector="Button.segment">
        <Setter Property="Height" Value="48" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="seg" Background="Transparent" CornerRadius="7" Padding="4,6">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.segment:pointerover /template/ Border#seg">
        <Setter Property="Background" Value="{DynamicResource Hair}" />
    </Style>
    <Style Selector="Button.segment.active /template/ Border#seg">
        <Setter Property="Background" Value="{DynamicResource PanelSolid}" />
        <Setter Property="BoxShadow" Value="0 1 3 0 #1F000000" />
    </Style>
    <Style Selector="Button.segment Path">
        <Setter Property="Stroke" Value="{DynamicResource Ink2}" />
    </Style>
    <Style Selector="Button.segment.active Path">
        <Setter Property="Stroke" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Button.segment TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Ink2}" />
    </Style>
    <Style Selector="Button.segment.active TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>

    <!-- ── Checkbox (file row) ── ToggleButton.check, custom 16px box. -->
    <Style Selector="ToggleButton.check">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="box" Width="16" Height="16" CornerRadius="5"
                        Background="Transparent"
                        BorderBrush="{DynamicResource Ink3}" BorderThickness="1.5">
                    <Path Name="tick" Data="{StaticResource IcoCheck}" Stroke="White"
                          StrokeThickness="3" Stretch="Uniform" Width="9" Height="9"
                          IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.check:checked /template/ Border#box">
        <Setter Property="Background" Value="{DynamicResource Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="ToggleButton.check:checked /template/ Path#tick">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- ── Toggle switch (RFC 3161) ── ToggleButton.switch, 38×22 pill. -->
    <Style Selector="ToggleButton.switch">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="track" Width="38" Height="22" CornerRadius="11"
                        Background="{DynamicResource Hair2}">
                    <Ellipse Name="knob" Width="18" Height="18" Fill="White"
                             HorizontalAlignment="Left" Margin="2,0,0,0" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.switch:checked /template/ Border#track">
        <Setter Property="Background" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="ToggleButton.switch:checked /template/ Ellipse#knob">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,0,2,0" />
    </Style>

    <!-- ── Spinner ── a 270° arc that rotates. -->
    <Style Selector="Path.spin">
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Style.Animations>
            <Animation Duration="0:0:0.8" IterationCount="Infinite">
                <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- ── Pills (status chips) ── Border.pill + a tone class. -->

    <Style Selector="Border.pill">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,3" />
    </Style>
    <Style Selector="Border.pill.ok">
        <Setter Property="Background" Value="{DynamicResource OkSoft}" />
    </Style>
    <Style Selector="Border.pill.ok TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Ok}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.pill.accent">
        <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    </Style>
    <Style Selector="Border.pill.accent TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

</Styles>
