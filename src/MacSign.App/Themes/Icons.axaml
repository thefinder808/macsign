    <StreamGeometry x:Key="IcoFingerprint">M12 5a7 7 0 00-7 7v2 M19 12a7 7 0 00-3-5.7 M8.5 12a3.5 3.5 0 017 0v3 M12 12v4 M15.5 16.5a8 8 0 01-.5 2.5 M5.5 16a10 10 0 00.5 4</StreamGeometry>
    <StreamGeometry x:Key="IcoAlert">M12 4l9 16H3l9-16z M12 10v4 M12 17.5v.2</StreamGeometry>
    <StreamGeometry x:Key="IcoGear">M12 15a3 3 0 1 0 0-6 a3 3 0 0 0 0 6z M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z</StreamGeometry>

    <!-- 270° arc for the spinner (24×24 grid). -->
