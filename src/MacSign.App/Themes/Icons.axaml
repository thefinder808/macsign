<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Line-icon geometries (24×24 grid, rendered as 1.6px strokes, no fill)
         ported verbatim from the prototype's icon set (directions/shared.jsx).
         Render with: <Path Data="{StaticResource IcoX}" Stroke="..."
                            StrokeThickness="1.6" Stretch="Uniform"/> -->

    <StreamGeometry x:Key="IcoShield">M12 3l7 3v5c0 4.2-2.9 7.4-7 8.5C7.9 18.4 5 15.2 5 11V6l7-3z M9 11.5l2 2 4-4.2</StreamGeometry>
    <StreamGeometry x:Key="IcoCheck">M5 12.5l4.5 4.5L19 7</StreamGeometry>
    <StreamGeometry x:Key="IcoKey">M11 12h9 M17 12v3 M20 12v3.5 M4.8 12a3.2 3.2 0 1 0 6.4 0 a3.2 3.2 0 1 0 -6.4 0</StreamGeometry>
    <StreamGeometry x:Key="IcoChip">M8.5 6h7a2.5 2.5 0 0 1 2.5 2.5v7a2.5 2.5 0 0 1 -2.5 2.5h-7a2.5 2.5 0 0 1 -2.5 -2.5v-7a2.5 2.5 0 0 1 2.5 -2.5z M9.5 9.5h5v5h-5z M9 3v2 M15 3v2 M9 19v2 M15 19v2 M3 9h2 M3 15h2 M19 9h2 M19 15h2</StreamGeometry>
    <StreamGeometry x:Key="IcoCloud">M7 18a4 4 0 010-8 5 5 0 019.6-1.3A3.5 3.5 0 0117 18H7z</StreamGeometry>
    <StreamGeometry x:Key="IcoClock">M4 12a8 8 0 1 0 16 0 a8 8 0 1 0 -16 0 M12 8v4.2l2.8 1.8</StreamGeometry>
    <StreamGeometry x:Key="IcoDoc">M7 3h7l4 4v14H7z M14 3v4h4</StreamGeometry>
    <StreamGeometry x:Key="IcoPlus">M12 6v12 M6 12h12</StreamGeometry>
    <StreamGeometry x:Key="IcoX">M6 6l12 12 M18 6l-12 12</StreamGeometry>
    <StreamGeometry x:Key="IcoChevR">M9 5l7 7-7 7</StreamGeometry>
    <StreamGeometry x:Key="IcoBolt">M13 3L5 13h6l-1 8 8-10h-6l1-8z</StreamGeometry>
    <StreamGeometry x:Key="IcoReturn">M9 10l-4 4 4 4 M5 14h11a3 3 0 003-3V6</StreamGeometry>
    <StreamGeometry x:Key="IcoLock">M7 11h10a2 2 0 0 1 2 2v5a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2v-5a2 2 0 0 1 2 -2z M8 11V8a4 4 0 018 0v3</StreamGeometry>
