<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:MacSign.App.Views"
        x:Class="MacSign.App.Views.MainWindow"
        Title="MacSign"
        Width="1120" Height="740"
        MinWidth="1000" MinHeight="680"
        Background="{DynamicResource Bg1}">

    <!-- Phase 2: hosts the style guide. The real shell (sidebar + toolbar +
         views) replaces this in Phase 3. -->
    <views:StyleGuideView />

</Window>
