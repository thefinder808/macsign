<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MacSign.App.ViewModels"
        x:Class="MacSign.App.Views.NotaryProfileWindow"
        x:DataType="vm:NotaryProfileViewModel"
        Title="Set up notary profile"
        Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg1}">
    <StackPanel Margin="22" Spacing="12">
        <TextBlock Text="Create a keychain notary profile" FontSize="15" FontWeight="Bold"
                   Foreground="{DynamicResource Ink}" />
        <TextBlock Text="Uses an App Store Connect API key (.p8). The key stays in its file — nothing is stored by MacSign; the credentials go into your login keychain."
                   FontSize="12" Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" />

        <StackPanel Spacing="5">
            <TextBlock Classes="fieldlabel" Text="Profile name" />
            <TextBox Classes="mono" Text="{Binding ProfileName}" Watermark="my-notary-profile" />
        </StackPanel>
        <StackPanel Spacing="5">
            <TextBlock Classes="fieldlabel" Text="API key (.p8)" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0" Classes="mono" Text="{Binding ApiKeyPath}" Watermark="…/AuthKey_XXXX.p8" />
                <Button Grid.Column="1" Classes="ghost" Height="32" Padding="10,0"
                        Content="Choose…" Foreground="{DynamicResource Accent}" Command="{Binding ChooseKeyCommand}" />
            </Grid>
        </StackPanel>
        <StackPanel Spacing="5">
            <TextBlock Classes="fieldlabel" Text="Key ID" />
            <TextBox Classes="mono" Text="{Binding KeyId}" />
        </StackPanel>
        <StackPanel Spacing="5">
            <TextBlock Classes="fieldlabel" Text="Issuer ID" />
            <TextBox Classes="mono" Text="{Binding Issuer}" />
        </StackPanel>

        <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="{DynamicResource Fail}"
                   FontSize="12" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Classes="secondary" Content="Cancel" Click="OnCancel" />
            <Button Classes="primary" Content="Create profile" Command="{Binding CreateProfileCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
