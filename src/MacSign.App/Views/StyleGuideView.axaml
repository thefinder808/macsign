<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MacSign.App.Views.StyleGuideView">

    <ScrollViewer>
        <StackPanel Margin="28" Spacing="22" MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock Classes="title" Text="MacSign — Style Guide" FontSize="22" />
            <TextBlock Classes="subtitle"
                       Text="Phase 2 foundation: design tokens + primitive styles. Toggle macOS appearance to see light/dark." />

            <!-- Buttons -->
            <TextBlock Classes="section" Text="BUTTONS" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Classes="primary" Content="Sign 3 files" />
                <Button Classes="secondary" Content="Add files" />
                <Button Classes="ghost" Content="Verify another" />
            </StackPanel>

            <!-- Fields -->
            <TextBlock Classes="section" Text="FIELDS" />
            <StackPanel Spacing="8" MaxWidth="360" HorizontalAlignment="Left">
                <TextBlock Classes="fieldlabel" Text="Description" />
                <TextBox Text="WrapTune" />
                <TextBlock Classes="fieldlabel" Text="PKCS#11 module" />
                <TextBox Classes="mono" Text="/usr/local/lib/opensc-pkcs11.so" />
                <TextBlock Classes="fieldlabel" Text="Password" />
                <TextBox PasswordChar="•" Text="secret" />
            </StackPanel>

            <!-- Cards + pills -->
            <TextBlock Classes="section" Text="CARDS &amp; PILLS" />
            <Border Classes="card" Padding="16">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="WrapTune.exe" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Ink}" VerticalAlignment="Center" />
                        <Border Classes="pill ok" VerticalAlignment="Center">
                            <TextBlock Text="Signed" />
                        </Border>
                        <Border Classes="pill accent" VerticalAlignment="Center">
                            <TextBlock Text="Azure" />
                        </Border>
                    </StackPanel>
                    <TextBlock Classes="mono dim" FontSize="11.5" Text="4.2 MB · CN=Nathaniel Graham" />
                </StackPanel>
            </Border>

            <!-- File-type badges (simplified solid chips here; the 14%/28% chip
                 control lands with the Sign view in Phase 4) -->
            <TextBlock Classes="section" Text="FILE-TYPE BADGES" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Background="{DynamicResource BadgeExe}" CornerRadius="7" Width="34" Height="34">
                    <TextBlock Text="EXE" Foreground="White" FontSize="10" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Background="{DynamicResource BadgeDll}" CornerRadius="7" Width="34" Height="34">
                    <TextBlock Text="DLL" Foreground="White" FontSize="10" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Background="{DynamicResource BadgeSys}" CornerRadius="7" Width="34" Height="34">
                    <TextBlock Text="SYS" Foreground="White" FontSize="10" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Background="{DynamicResource BadgeMsi}" CornerRadius="7" Width="34" Height="34">
                    <TextBlock Text="MSI" Foreground="White" FontSize="10" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Background="{DynamicResource BadgePs1}" CornerRadius="7" Width="34" Height="34">
                    <TextBlock Text="PS1" Foreground="White" FontSize="10" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

</UserControl>
