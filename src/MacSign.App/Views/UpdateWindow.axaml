<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MacSign.App.ViewModels"
        x:Class="MacSign.App.Views.UpdateWindow"
        x:DataType="vm:UpdateViewModel"
        Title="Update Available"
        Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg1}">
    <StackPanel Margin="24" Spacing="14">

        <!-- Title -->
        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource Ink}" TextWrapping="Wrap" />

        <!-- Release notes -->
        <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <SelectableTextBlock Text="{Binding ReleaseNotes}"
                                 FontSize="12.5" Foreground="{DynamicResource Ink2}"
                                 TextWrapping="Wrap" />
        </ScrollViewer>

        <!-- Progress bar (only while busy) -->
        <ProgressBar IsVisible="{Binding Busy}"
                     Minimum="0" Maximum="1" Value="{Binding Progress}"
                     Height="6" />

        <!-- Status text -->
        <TextBlock Text="{Binding Status}"
                   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   FontSize="12" Foreground="{DynamicResource Ink2}"
                   TextWrapping="Wrap" />

        <!-- Buttons. Two right-aligned rows so the primary action can't be clipped on
             a narrow fixed-width dialog: low-emphasis links on top, the decision pair
             (Later / Install) below. -->
        <StackPanel Spacing="8" Margin="0,4,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Classes="ghost" Content="Release page ↗"
                        Foreground="{DynamicResource Accent}"
                        Click="OnOpenReleasePage" />
                <Button Classes="ghost" Content="Skip this version"
                        Foreground="{DynamicResource Ink2}"
                        Command="{Binding SkipCommand}" Click="OnSkip" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Classes="secondary" Content="Later" VerticalAlignment="Center"
                        IsCancel="True" Click="OnLater" />
                <Button Classes="primary" Content="Install &amp; Relaunch"
                        IsDefault="True"
                        Command="{Binding InstallCommand}"
                        IsEnabled="{Binding !Busy}" />
            </StackPanel>
        </StackPanel>

    </StackPanel>
</Window>
