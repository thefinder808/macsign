<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Optional Azure Trusted Signing (a.k.a. Azure Artifact Signing) backend,
    QUARANTINED in its own assembly so the core engine stays free of the
    Azure.Identity dependency. Only consumers who sign with a cloud key profile
    reference this. The signing key never leaves Azure: SigningKey is a delegating
    RSA that POSTs the digest to the Trusted Signing sign endpoint.
  -->
  <PropertyGroup>
    <RootNamespace>MacSign.Signing.Azure</RootNamespace>
    <AssemblyName>MacSign.Signing.Azure</AssemblyName>
    <IsPackable>true</IsPackable>
    <Description>Azure Trusted Signing (Azure Artifact Signing) credential backend for the MacSign.Signing Authenticode engine. The signing key stays in Azure's FIPS 140-2 L3 HSM; digests are signed via the Trusted Signing REST endpoint. Reference this package and call AzureBackend.Register().</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MacSign.Signing\MacSign.Signing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The contract test injects a fake HttpMessageHandler + token to prove the
         delegated path offline (no live Azure account needed). -->
    <InternalsVisibleTo Include="MacSign.Signing.Tests" />
  </ItemGroup>

</Project>
