<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>MacSign.Signing.Msi</RootNamespace>
    <AssemblyName>MacSign.Signing.Msi</AssemblyName>
    <IsPackable>true</IsPackable>
    <Description>MSI (Windows Installer / OLE2 compound file) format backend for the MacSign.Signing Authenticode engine. Reference this package and call MsiBackend.Register() to sign .msi files.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MacSign.Signing\MacSign.Signing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenMcdf" Version="3.1.4" />
  </ItemGroup>

</Project>
