<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Optional PKCS#11 / HSM backend, QUARANTINED in its own assembly so the core
    engine stays free of the third-party + native Pkcs11Interop dependency. Only
    consumers who sign with a token reference this.
  -->
  <PropertyGroup>
    <RootNamespace>MacSign.Signing.Pkcs11</RootNamespace>
    <AssemblyName>MacSign.Signing.Pkcs11</AssemblyName>
    <IsPackable>true</IsPackable>
    <Description>PKCS#11 hardware token / HSM credential backend for the MacSign.Signing Authenticode engine. The private key never leaves the token. Reference this package and call Pkcs11Backend.Register() to sign with a PKCS#11 module.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pkcs11Interop.X509Store" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MacSign.Signing\MacSign.Signing.csproj" />
  </ItemGroup>

</Project>
