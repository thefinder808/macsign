<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The signing engine. No THIRD-PARTY dependencies by design (keeps the eventual
    notarized app dependency-clean and auditable). The single PackageReference below
    is System.Security.Cryptography.Pkcs — a Microsoft first-party platform package
    that supplies the CMS APIs (it is not bundled in the base framework ref pack).
  -->
  <PropertyGroup>
    <RootNamespace>MacSign.Signing</RootNamespace>
    <AssemblyName>MacSign.Signing</AssemblyName>
    <IsPackable>true</IsPackable>
    <Description>Cross-platform Authenticode signing engine. Signs PE (.exe/.dll/.sys) and PowerShell (.ps1) files with a PFX certificate, with RFC3161 timestamping and signature verification, from any OS. MSI, PKCS#11 token, and Azure Trusted Signing support are in the MacSign.Signing.Msi / .Pkcs11 / .Azure backend packages.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MacSign.Signing.Tests" />
    <!-- Backends implement internal interfaces + registration hooks. -->
    <InternalsVisibleTo Include="MacSign.Signing.Pkcs11" />
    <InternalsVisibleTo Include="MacSign.Signing.Msi" />
    <InternalsVisibleTo Include="MacSign.Signing.Azure" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.8" />
  </ItemGroup>

</Project>
